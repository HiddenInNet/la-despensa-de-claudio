---
import { ClientRouter } from "astro:transitions";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";
import ShoppingComponent from "../components/shopping/ShoppingComponent.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;

const userLang = getLangFromUrl(Astro.url) ?? "es";
---

<!doctype html>
<html lang={userLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        <title>{title}</title>
    </head>
    <body class="flex min-h-screen flex-col text-neutral-900">
        <Header transition:persist />
        <main class="md:font-inter flex-1 bg-neutral-100 pt-18">
            <slot />
        </main>
        <ShoppingComponent transition:persist />
        <Footer transition:persist />
    </body>
</html>
