---
import { ClientRouter } from "astro:transitions";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";
import CartDrawer from "../components/shopping/CartDrawer.tsx";
import { getImage } from "astro:assets";
import dehesa from "../assets/images/dehesa.jpg";

// 1. Ampliamos las Props para recibir información vital de cada página
interface Props {
    title: string;
    description: string;
    image?: string; // Opcional: Imagen que sale al compartir en WhatsApp/Twitter
    canonicalURL?: URL | string; // Opcional: Para evitar penalizaciones por contenido duplicado
}

const preloadImage = await getImage({
    src: dehesa,
    format: "avif",
    width: 1920,
    quality: 80,
});

const {
    title,
    description,
    image = "/images/dehesa.jpg",
    canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin),
} = Astro.props;

const userLang = getLangFromUrl(Astro.url) ?? "es";

const socialImageURL = new URL(image, Astro.url.origin);
---

<!doctype html>
<html lang={userLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />

        <link
            rel="preload"
            href={preloadImage.src}
            as="image"
            type="image/avif"
            fetchpriority="high"
        />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />
    </head>
    <body class="flex min-h-screen flex-col text-neutral-900">
        <Header transition:persist />
        <main class="md:font-inter flex-1 bg-neutral-100 pt-18">
            <slot />
        </main>
        <CartDrawer client:only="preact" />
        <Footer transition:persist />
    </body>
</html>
