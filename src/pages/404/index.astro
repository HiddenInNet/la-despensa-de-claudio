---
import { getLangFromUrl } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
---

<Layout title="Página no encontrada - La Despensa de Claudio">
    <main
        class="flex min-h-[80vh] w-full items-center justify-center bg-stone-50 px-4"
    >
        <div class="w-full max-w-2xl text-center">
            <div class="mb-8 flex justify-center">
                <div class="relative">
                    <span
                        class="font-serif text-[12rem] leading-none text-stone-200 select-none"
                        >404</span
                    >
                    <div
                        class="absolute inset-0 flex items-center justify-center"
                    >
                        <span
                            class="mt-8 font-serif text-3xl text-green-900 md:text-4xl"
                            >Bocado no encontrado</span
                        >
                    </div>
                </div>
            </div>

            <h1 class="mb-4 font-serif text-2xl text-stone-800 md:text-3xl">
                Parece que esta pieza no está en nuestra bodega
            </h1>

            <p
                class="mx-auto mb-10 max-w-md leading-relaxed font-light text-stone-600"
            >
                Lo sentimos, la página que buscas no existe o ha sido movida. Te
                invitamos a volver a nuestra selección exclusiva para seguir
                disfrutando de lo mejor de nuestra tierra.
            </p>

            <div class="flex flex-col justify-center gap-4 sm:flex-row">
                <a
                    href="/"
                    class="rounded-sm bg-green-900 px-8 py-4 text-xs font-bold tracking-[0.2em] text-white uppercase shadow-md transition-all duration-300 hover:bg-green-800"
                >
                    Volver al Inicio
                </a>
                <a
                    href={`${lang}/products`}
                    class="rounded-sm border border-stone-300 px-8 py-4 text-xs font-bold tracking-[0.2em] text-stone-600 uppercase transition-all duration-300 hover:border-green-900 hover:text-green-900"
                >
                    Ver Catálogo
                </a>
            </div>
        </div>
    </main>
</Layout>

<style>
    /* Animación suave para el número de fondo */
    h1,
    p,
    a {
        animation: fadeIn 0.8s ease-out forwards;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
