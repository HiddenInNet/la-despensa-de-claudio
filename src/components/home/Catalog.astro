---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="mx-auto w-full max-w-7xl px-6 py-20">
    <div class="mb-16 text-center">
        <h2 class="mb-4 font-serif text-4xl tracking-tight text-green-800">
            Nuestras Joyas
        </h2>
        <div class="mx-auto h-1 w-20 bg-green-700"></div>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3">
        <a
            href={`/${lang}/products?cat=JAMON`}
            class="group relative block h-96 overflow-hidden rounded-sm bg-gray-100"
        >
            <div
                class="absolute inset-0 bg-[url('/images/iberic-jam.avif')] bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            >
            </div>
            <div
                class="absolute inset-0 bg-black/30 transition-all group-hover:bg-black/20"
            >
            </div>
            <div class="absolute bottom-0 left-0 p-8">
                <h3 class="mb-2 font-serif text-3xl text-white">Jamones</h3>
                <p class="text-sm tracking-widest text-white/90 uppercase">
                    Ver Selección →
                </p>
            </div>
        </a>

        <a
            href={`/${lang}/products?cat=EMBUTIDO`}
            class="group relative block h-96 overflow-hidden rounded-sm bg-gray-100"
        >
            <div
                class="absolute inset-0 bg-[url('/images/cured-meat.avif')] bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            >
            </div>
            <div
                class="absolute inset-0 bg-black/30 transition-all group-hover:bg-black/20"
            >
            </div>
            <div class="absolute bottom-0 left-0 p-8">
                <h3 class="mb-2 font-serif text-3xl text-white">Embutidos</h3>
                <p class="text-sm tracking-widest text-white/90 uppercase">
                    Ver Selección →
                </p>
            </div>
        </a>

        <a
            href={`/${lang}/products?cat=QUESO`}
            class="group relative col-span-1 block h-96 overflow-hidden rounded-sm bg-gray-100"
        >
            <div
                class="absolute inset-0 bg-[url('/images/cheese-table.avif')] bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            >
            </div>
            <div
                class="absolute inset-0 bg-black/30 transition-all group-hover:bg-black/20"
            >
            </div>
            <div class="absolute bottom-0 left-0 p-8">
                <h3 class="mb-2 font-serif text-3xl text-white">Quesos</h3>
                <p class="text-sm tracking-widest text-white/90 uppercase">
                    Ver Selección →
                </p>
            </div>
        </a>

        <a
            href={`/${lang}/products?cat=VINO`}
            class="group relative col-span-1 block h-96 overflow-hidden rounded-sm bg-gray-100"
        >
            <div
                class="absolute inset-0 bg-[url('/images/wine-glass.avif')] bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
            >
            </div>
            <div
                class="absolute inset-0 bg-black/30 transition-all group-hover:bg-black/20"
            >
            </div>
            <div class="absolute bottom-0 left-0 p-8">
                <h3 class="mb-2 font-serif text-3xl text-white">Vinos</h3>
                <p class="text-sm tracking-widest text-white/90 uppercase">
                    Ver Selección →
                </p>
            </div>
        </a>
    </div>
</section>
