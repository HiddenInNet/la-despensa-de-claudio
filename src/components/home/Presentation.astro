---
import { getImage, Image } from "astro:assets";
import dehesa from "../../assets/images/dehesa.jpg";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import BUS_DATA from "../../docs/bussiness-data.json";

const optimizedImage = await getImage({ src: dehesa, format: "avif" });

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<link rel="preload" fetchpriority="high" as="image" href={optimizedImage.src} />

<section
    id="hero-section"
    class="relative flex min-h-125 w-full items-center justify-center overflow-hidden bg-green-800"
>
    <div class="absolute inset-0 bg-green-800 opacity-60">
        <Image
            id="hero-bg"
            src={dehesa}
            alt="imagen-de-dehesa-iberica-la-despensa-de-claudio"
            loading="eager"
            fetchpriority="high"
            format="avif"
            widths={[640, 1024, 1920]}
            sizes="(max-width: 1024px) 100vw, 100vw"
            class="h-full w-full object-cover"
        />
    </div>

    <div class="relative z-10 px-4 text-center">
        <span
            class="mb-4 block text-sm font-light tracking-[0.3em] text-white uppercase"
        >
            Tradición y Sabor
        </span>
        <h1
            class="mb-6 font-serif text-5xl text-white drop-shadow-md md:text-7xl"
        >
            {BUS_DATA.bussiness_name}
        </h1>
        <p
            class="mx-auto mb-10 max-w-2xl text-lg font-light text-green-50 md:text-xl"
        >
            Selección exclusiva de embutidos y jamones ibéricos directos desde
            la raíz a tu mesa.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <a
                href={`/${lang}/products`}
                class="rounded-sm bg-white px-10 py-4 text-sm font-bold tracking-widest text-green-800 uppercase shadow-lg transition-all hover:bg-green-50"
            >
                Ver Catálogo
            </a>
            <a
                href={`/${lang}/about`}
                class="rounded-sm border border-white px-10 py-4 text-sm font-bold tracking-widest text-white uppercase transition-all hover:bg-white hover:text-green-800"
            >
                Nuestra Historia
            </a>
        </div>
    </div>
</section>
