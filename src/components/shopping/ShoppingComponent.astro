---
import ShoppingCart from "../../assets/svg/shopping-cart.svg";
import CartResume from "./CartResume.astro";
import Close from "../../assets/svg/close.svg";
---

<button
    id="cart-toggle-btn"
    aria-label="Abrir carrito de compras"
    class="group fixed right-5 bottom-10 z-50 flex items-center justify-center rounded-full border border-neutral-100 bg-green-800 p-4 text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:cursor-pointer hover:bg-green-700 hover:shadow-xl focus:ring-4 focus:ring-green-800/30 focus:outline-none"
>
    <ShoppingCart class="size-7 transition-transform group-hover:scale-110" />

    <span
        id="cart-badge"
        class="absolute -top-1 -right-1 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-red-500 text-xs font-bold text-white shadow-sm"
    >
        0
    </span>
</button>

<div
    id="cart-backdrop"
    class="pointer-events-none fixed inset-0 z-40 bg-neutral-900/40 opacity-0 backdrop-blur-sm transition-opacity duration-300"
>
</div>

<section
    id="cart-drawer"
    class="fixed bottom-0 left-0 z-50 flex h-[80vh] max-h-screen w-full translate-y-full transform flex-col overflow-hidden rounded-t-3xl bg-white shadow-2xl transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] md:right-5 md:bottom-0 md:left-auto md:h-150 md:w-120 md:rounded-2xl"
>
    <div
        class="flex items-center justify-between border-b border-neutral-100 bg-stone-50 p-6"
    >
        <h2 class="font-serif text-2xl text-green-800">Tu Despensa</h2>
        <button
            id="close-cart-btn"
            class="rounded-full p-2 text-red-500 transition-colors hover:cursor-pointer hover:bg-stone-200 hover:text-red-400"
            aria-label="Cerrar carrito"
        >
            <Close />
        </button>
    </div>

    <div
        id="shop-items-list"
        class="flex flex-1 flex-col gap-4 overflow-y-auto p-6"
    >
    </div>

    <CartResume />
</section>

<!-- Comportamiento del boton del carrito -->
<script>
    import { initCartMenu } from "../../utils/ShopCartScripts";
    document.addEventListener("astro:page-load", initCartMenu);
</script>

<script>
    import type { ShopItem } from "../../types/shop";
    import {
        updateCartBadge,
        getProductListFromLocalStorage,
        setProductListFromLocalStorage,
    } from "../../utils/ShopCartScripts";

    function init() {
        const cartBtn = document.getElementById(
            "cart-toggle-btn",
        ) as HTMLButtonElement;
        const itemsList = document.getElementById(
            "shop-items-list",
        ) as HTMLElement;

        function loadItems() {
            if (!itemsList) return;

            try {
                const items: ShopItem[] = getProductListFromLocalStorage();

                itemsList.innerHTML =
                    items.length > 0
                        ? items
                              .map((item, index) => createItem(item, index))
                              .join("")
                        : '<p class="text-center text-stone-400 py-10">Tu despensa está vacía</p>';

                updateCartBadge();

                window.dispatchEvent(new CustomEvent("refresh-total-price"));
            } catch (e) {
                console.error("Error: ", e);
            }
        }

        itemsList?.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            const deleteBtn = target.closest(
                '[data-action^="delete-"]',
            ) as HTMLButtonElement;

            if (deleteBtn) {
                const index = parseInt(
                    (deleteBtn as HTMLElement).dataset.action!.split("-")[1],
                );
                removeItem(index);
            }
        });

        function removeItem(index: number) {
            try {
                const shopList: ShopItem[] =
                    getProductListFromLocalStorage() ?? [];
                const newList = shopList.filter((_, i) => i !== index);

                setProductListFromLocalStorage(newList);

                window.dispatchEvent(new CustomEvent("cart-updated"));

                loadItems();
            } catch (error) {
                console.error("Error al borrar:", error);
            }
        }

        function createItem(item: ShopItem, index: number) {
            const path = window.location.pathname;
            const lang = path.split("/")[1] || "es";

            const priceFormatter = new Intl.NumberFormat("es-ES", {
                style: "currency",
                currency: "EUR",
            });

            const isNumericFormat = !isNaN(Number(item.format));
            const pieceWeight = Number(item.pieceWeight) / 1000;
            const weightMultiplier = isNumericFormat
                ? Number(item.format) / 1000
                : pieceWeight;

            // Precio por unidad de formato (en euros)
            const unitPrice =
                (Number(item.pricePerKg) / 100) * weightMultiplier;
            const lineTotal = unitPrice * Number(item.quantity);

            return `
                <div class="flex gap-4 pb-4 border-b border-stone-100 group relative">
                    <a href="/${lang}/products/${item.id}" class="flex gap-4 flex-1">
                        <div class="w-20 h-20 bg-stone-200 rounded-md overflow-hidden flex-shrink-0">
                            <img 
                                src="${item.image ?? "/images/no-photo.avif"}" 
                                alt="${item.name}" 
                                class="w-full h-full object-cover"
                                loading="lazy"
                            />
                        </div>
                        
                        <div class="flex flex-col justify-between py-1">
                            <div>
                                <h3 class="font-bold text-stone-800 text-sm md:text-base leading-tight">
                                    ${item.name}
                                </h3>
                                <p class="text-stone-500 text-xs mt-1">
                                    ${item.quantity} x ${isNumericFormat ? item.format + " gr" : "Pieza entera"}
                                </p>
                            </div>
                            <h4 class="text-xs text-stone-400">
                                ${priceFormatter.format(Number(item.pricePerKg) / 100)} / kg
                            </h4>
                        </div>
                    </a>

                    <div class="flex flex-col justify-between items-end py-1">
                        <button 
                            data-action="delete-${index}"
                            class="text-stone-300 hover:text-red-600 transition-colors cursor-pointer p-1"
                            aria-label="Eliminar producto"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor">
                                <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                            </svg>                        
                        </button>
                        
                        <span class="font-bold text-green-800 text-sm">
                            ${priceFormatter.format(lineTotal)}
                        </span>
                    </div>
                </div>    
            `;
        }

        cartBtn?.addEventListener("click", loadItems);

        window.addEventListener("cart-updated", loadItems);
    }

    document.addEventListener("astro:page-load", init);
</script>
