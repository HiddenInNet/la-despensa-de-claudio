---
interface Props {
    category: string;
    name: string;
    formattedCategory: string;
}

const { category, name, formattedCategory } = Astro.props;
---

<nav class="w-full border-b border-stone-200 bg-stone-50 py-4">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <ol
            class="flex items-center space-x-2 text-sm font-light text-stone-500"
        >
            <li>
                <a href="/" class="transition-colors hover:text-green-800"
                    >Inicio</a
                >
            </li>
            <li><span class="mx-1">/</span></li>
            <li>
                <a
                    href="../products"
                    class="transition-colors hover:text-green-800">Catálogo</a
                >
            </li>
            <li><span class="mx-1">/</span></li>
            <li>
                <a
                    href={`../products?cat=${category}`}
                    class="transition-colors hover:text-green-800"
                    >{formattedCategory}</a
                >
            </li>
            <li><span class="mx-1">/</span></li>
            <li class="truncate font-medium text-stone-800">{name}</li>
        </ol>
    </div>
</nav>
