---
import type { ProductDetail } from "../../../types/products";
import { products_categories } from "../../../docs/bussiness-data.json";

interface Props {
    product: ProductDetail;
}

const { product } = Astro.props;

const divisibleCategories: string[] = products_categories.flatMap((c) =>
    c.divisible ? [c.slug] : [],
);
---

<product-add data-product={JSON.stringify(product)}>
    <div class="mt-8 flex flex-col gap-8">
        {
            divisibleCategories.includes(product.category) && (
                <div>
                    <span class="mb-4 block text-xs font-bold tracking-widest text-stone-800 uppercase">
                        Selecciona el formato:
                    </span>
                    <div class="flex flex-wrap gap-3" id="weight-selector">
                        <button
                            type="button"
                            data-weight="100"
                            class="weight-btn rounded-sm border-2 border-green-800 bg-green-800 px-5 py-2 text-sm font-medium text-white transition-colors hover:cursor-pointer"
                        >
                            100 gr
                        </button>
                        <button
                            type="button"
                            data-weight="250"
                            class="weight-btn rounded-sm border-2 border-stone-200 px-5 py-2 text-sm font-medium text-stone-600 transition-colors hover:cursor-pointer hover:border-green-800 hover:text-green-800"
                        >
                            250 gr
                        </button>
                        <button
                            type="button"
                            data-weight="500"
                            class="weight-btn rounded-sm border-2 border-stone-200 px-5 py-2 text-sm font-medium text-stone-600 transition-colors hover:cursor-pointer hover:border-green-800 hover:text-green-800"
                        >
                            500 gr
                        </button>
                        <button
                            type="button"
                            data-weight="whole"
                            class="weight-btn rounded-sm border-2 border-stone-200 px-5 py-2 text-sm font-medium text-stone-600 transition-colors hover:cursor-pointer hover:border-green-800 hover:text-green-800"
                        >
                            Pieza entera
                        </button>
                        <button
                            type="button"
                            data-weight="custom"
                            class="weight-btn rounded-sm border-2 border-stone-200 px-5 py-2 text-sm font-medium text-stone-600 transition-colors hover:cursor-pointer hover:border-green-800 hover:text-green-800"
                        >
                            Personalizado
                        </button>
                    </div>

                    <div
                        id="custom-weight-container"
                        class="animate-fade-in mt-4 hidden items-center gap-3"
                    >
                        <input
                            type="number"
                            id="custom-weight-input"
                            min="50"
                            step="50"
                            placeholder="Ej: 250"
                            class="w-28 rounded-sm border border-stone-300 p-2.5 text-stone-800 focus:border-green-800 focus:ring-1 focus:ring-green-800 focus:outline-none"
                        />
                        <span class="text-sm text-stone-500">
                            gramos (mín. 100g)
                        </span>
                    </div>
                </div>
            )
        }

        <div class="flex flex-col gap-4 sm:flex-row">
            <div
                class="flex w-fit items-center justify-center rounded-sm border border-stone-300 bg-white py-4"
            >
                <button
                    id="btn-minus"
                    class="h-full px-4 text-stone-500 transition-colors hover:cursor-pointer hover:text-green-800 focus:outline-none"
                    aria-label="Disminuir cantidad"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M20 12H4"></path></svg
                    >
                </button>
                <input
                    type="number"
                    id="qty-input"
                    value="1"
                    min="1"
                    readonly
                    class="pointer-events-none w-12 bg-transparent text-center font-bold text-stone-800 focus:outline-none"
                />
                <button
                    id="btn-plus"
                    class="h-full px-4 text-stone-500 transition-colors hover:cursor-pointer hover:text-green-800 focus:outline-none"
                    aria-label="Aumentar cantidad"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 4v16m8-8H4"></path></svg
                    >
                </button>
            </div>

            <button
                id="add-to-cart-btn"
                class="flex w-full items-center justify-center rounded-sm bg-green-800 px-8 py-4 text-sm font-bold tracking-widest text-white uppercase shadow-md transition-colors hover:cursor-pointer hover:bg-green-800"
            >
                Añadir a la cesta
            </button>
        </div>
    </div>
</product-add>

<script>
    import type { ProductDetail } from "../../../types/products";
    import { updateCartBadge } from "../../../utils/ShopCartScripts";
    import { products_categories } from "../../../docs/bussiness-data.json";

    class ProductAdd extends HTMLElement {
        connectedCallback() {
            const productData: string = this.dataset.product ?? "";
            if (!productData) return;

            const divisibleCategories: string[] = products_categories.flatMap(
                (c) => (c.divisible ? [c.slug] : []),
            );

            const product: ProductDetail = JSON.parse(productData);

            const btnMinus = this.querySelector(
                "#btn-minus",
            ) as HTMLButtonElement;
            const btnPlus = this.querySelector(
                "#btn-plus",
            ) as HTMLButtonElement;
            const inputQty = this.querySelector(
                "#qty-input",
            ) as HTMLInputElement;
            const btnAddToCart = this.querySelector(
                "#add-to-cart-btn",
            ) as HTMLButtonElement;

            const weightButtons = this.querySelectorAll(".weight-btn");
            const customWeightContainer = this.querySelector(
                "#custom-weight-container",
            ) as HTMLDivElement;
            const customWeightInput = this.querySelector(
                "#custom-weight-input",
            ) as HTMLInputElement;

            if (!btnMinus || !btnPlus || !inputQty || !btnAddToCart) return;

            let selectedWeight = divisibleCategories.includes(product.category)
                ? "100"
                : "whole";

            // Logica de seleccion de Peso
            weightButtons.forEach((button) => {
                button.addEventListener("click", (e) => {
                    weightButtons.forEach((btn) => {
                        btn.classList.remove(
                            "border-green-800",
                            "bg-green-800",
                            "text-white",
                        );
                        btn.classList.add(
                            "border-stone-200",
                            "text-stone-600",
                            "hover:border-green-800",
                            "hover:text-green-800",
                        );
                    });

                    const clickedBtn = e.currentTarget as HTMLButtonElement;
                    clickedBtn.classList.remove(
                        "border-stone-200",
                        "text-stone-600",
                        "hover:border-green-800",
                        "hover:text-green-800",
                    );
                    clickedBtn.classList.add(
                        "border-green-800",
                        "bg-green-800",
                        "text-white",
                    );

                    selectedWeight =
                        clickedBtn.getAttribute("data-weight") || "100";

                    if (selectedWeight === "custom") {
                        customWeightContainer.classList.remove("hidden");
                        customWeightInput.focus();
                    } else {
                        customWeightContainer.classList.add("hidden");
                    }
                });
            });

            // Logica de Unidades (+ / -)
            btnMinus.addEventListener("click", () => {
                let currentValue = parseInt(inputQty.value);
                if (currentValue > 1) {
                    inputQty.value = (currentValue - 1).toString();
                }
            });

            btnPlus.addEventListener("click", () => {
                let currentValue = parseInt(inputQty.value);
                inputQty.value = (currentValue + 1).toString();
            });

            // Lógica de Añadir al Carrito
            btnAddToCart.addEventListener("click", () => {
                const units = parseInt(inputQty.value);
                let finalWeight = selectedWeight;

                // Validación peso personalizado
                if (selectedWeight === "custom") {
                    const customValue = parseInt(customWeightInput.value);
                    if (!customValue || customValue < 100) {
                        alert(
                            "Por favor, introduce una cantidad válida (mínimo 100g)",
                        );
                        return;
                    }
                    finalWeight = customValue.toString();
                }

                const item = {
                    id: product.id,
                    name: product.name,
                    image: product.url,
                    pricePerKg: product.price,
                    pieceWeight: product.weight,
                    format: finalWeight,
                    quantity: units,
                };

                try {
                    const localData = localStorage.getItem("SHOP_LIST");
                    let shopList = localData ? JSON.parse(localData) : [];

                    const existingItemIndex = shopList.findIndex(
                        (cartItem: any) =>
                            cartItem.id === item.id &&
                            cartItem.format === item.format,
                    );

                    if (existingItemIndex !== -1) {
                        shopList[existingItemIndex].quantity += item.quantity;
                    } else {
                        shopList.push(item);
                    }

                    localStorage.setItem("SHOP_LIST", JSON.stringify(shopList));

                    updateCartBadge();
                } catch (e) {
                    console.error("Error al actualizar el carrito:", e);
                }

                const originalText = btnAddToCart.innerHTML;
                btnAddToCart.innerHTML = "¡Añadido!";
                btnAddToCart.classList.replace("bg-green-800", "bg-green-600");

                setTimeout(() => {
                    btnAddToCart.innerHTML = originalText;
                    btnAddToCart.classList.replace(
                        "bg-green-600",
                        "bg-green-800",
                    );
                }, 1500);
            });
        }
    }

    if (!customElements.get("product-add")) {
        customElements.define("product-add", ProductAdd);
    }
</script>
