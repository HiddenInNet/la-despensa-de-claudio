---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import defaultImage from "../../assets/images/no-photo.avif";
import type { ProductsList } from "../../types/products";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const product = Astro.props.product as ProductsList;

// Formateador de moneda
const priceFormatter = new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency: "EUR",
});

const formattedCategory =
    product.category.charAt(0).toUpperCase() +
    product.category.slice(1).toLowerCase();
const priceInEuros = product.price / 100;
---

<article
    id={`product-${product.id}-section`}
    class="group flex w-full flex-col overflow-hidden rounded-sm border border-stone-300 bg-white shadow-sm transition-all duration-300 hover:border-green-700 hover:shadow-lg"
>
    <a href={`./products/${product.id}`} class="flex h-full flex-col">
        <div class="relative h-56 w-full overflow-hidden bg-stone-100">
            <Image
                src={product.url ?? defaultImage}
                alt={`${product.name}`}
                width="50"
                height="50"
                loading="eager"
                fetchpriority="high"
                transition:name={`product-image-${product.id}`}
                class="h-full w-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-105"
            />
            <span
                class="absolute top-3 left-3 bg-green-800 px-3 py-1 text-[10px] font-bold tracking-widest text-white uppercase shadow-md"
            >
                {formattedCategory}
            </span>
        </div>

        <div class="flex grow flex-col p-6">
            <div class="grow">
                <h3
                    class="mb-3 font-serif text-xl leading-tight font-bold text-green-800 transition-colors group-hover:text-green-700"
                >
                    {product.name}
                </h3>
                <p
                    class="line-clamp-3 text-sm leading-relaxed font-light text-stone-500"
                >
                    {product.description}
                </p>
            </div>

            <div
                class="mt-6 flex items-center justify-between border-t border-stone-100 pt-4"
            >
                <span class="font-serif text-2xl font-bold text-gray-900">
                    {priceFormatter.format(priceInEuros)}
                    <span class="text-sm font-thin text-neutral-500">
                        / kg
                    </span>
                </span>
                <span
                    class="border-b-2 border-transparent pb-0.5 text-xs font-bold tracking-widest text-green-800 uppercase transition-all duration-300 group-hover:border-green-800"
                >
                    Ver Detalles →
                </span>
            </div>
        </div>
    </a>
</article>
