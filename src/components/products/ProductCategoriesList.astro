---
import type { Category } from "../../types/category";

interface Props {
    categories: Category[];
    currentCategory: string;
}

const { categories, currentCategory } = Astro.props;
---

<div
    class="sticky top-18 z-10 w-full border-b border-stone-200 bg-white py-4 shadow-sm"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div
            id="tags-list"
            class="hide-scrollbar flex w-full items-center gap-3 overflow-x-auto pb-1"
        >
            {
                categories.map((category: Category) => {
                    const isActive = currentCategory === category.slug;

                    return (
                        <a
                            href={`?cat=${category.slug}`}
                            class={`rounded-sm border px-6 py-2 text-sm font-bold tracking-wide whitespace-nowrap uppercase transition-all duration-300 ${
                                isActive
                                    ? "border-green-900 bg-green-900 text-white shadow-md"
                                    : "border-stone-300 bg-stone-50 text-stone-600 hover:border-green-900 hover:text-green-900"
                            } `}
                        >
                            {category.label}
                        </a>
                    );
                })
            }
        </div>
    </div>
</div>

<style>
    /* Ocultar la barra de desplazamiento (scrollbar) en navegadores webkit pero permitir el scroll */
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
    }
</style>
