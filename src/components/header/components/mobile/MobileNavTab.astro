---
interface Props {
    href: string;
    title: string;
}

const { href, title } = Astro.props as Props;

const { pathname } = Astro.url;
const isActive = pathname === href || pathname === `${href}/`;
---

<li class="flex items-center justify-start px-6">
    <a
        href={href}
        class={`flex w-full items-center gap-3 rounded-xl p-4 text-lg font-medium transition-colors text-neutral-200 hover:bg-green-800/50 focus:bg-green-700 ${isActive ? 'bg-green-700 text-white font-semibold' : ''}`}
        aria-current={isActive ? "page" : undefined}
    >
        <div class="flex h-6 w-6 shrink-0 items-center justify-center text-current">
            <slot />
        </div>
        
        <span class="text-nowrap">{title}</span>
    </a>
</li>