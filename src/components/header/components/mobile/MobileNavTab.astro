---
interface Props {
    href: string;
    title: string;
}

const { href, title } = Astro.props as Props;
---

<li class="flex items-center justify-start px-6">
    <a
        href={`${href}`}
        class="flex w-full items-center gap-2 rounded-xl p-4 text-neutral-200 focus:bg-green-700"
    >
        <slot />
        <h3 class="rounded-xl text-lg text-nowrap">{title}</h3>
    </a>
</li>
